/* ==========================================================================
   CH01: BASIC CLAUDE COPY — FLAGSHIP DESIGN TOKENS (READ-ONLY)
   CLI Agents (3.8 Flash): DO NOT EDIT THIS FILE. Import via <link>.
   ========================================================================== */
@import url('https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Hind+Siliguri:wght@500;600;700&family=JetBrains+Mono:wght@500;700&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap');

:root {
  /* 1. Dual-Polarity Canvas Surfaces */
  --paper-top: #F6F8F4;
  --paper-base: #EEF1EB;
  --paper-edge: #E3E8DF;

  --emerald-glow: #0D593E;
  --emerald-base: #063D2A;
  --emerald-deep: #022317;

  /* 2. Brand & Semantic Accents (Swap per sub-series if needed) */
  --brand-primary: #064E35;
  --brand-primary-light: #0D6B4A;
  --brand-gold: #E5A93C;
  --brand-gold-bright: #F4BE52;
  --brand-gold-rgb: 229, 169, 60;
  --brand-coral: #E5484D;
  --brand-coral-rgb: 229, 72, 77;

  /* 3. Ink Hierarchy */
  --ink-dark: #101A16;
  --ink-dark-secondary: #42524B;
  --ink-dark-muted: #6C7D76;

  --ink-light: #FFFFFF;
  --ink-light-secondary: #D7E7DF;
  --ink-light-muted: #93B5A7;

  /* 4. Tactile Surfaces & Multi-Layer Elevation */
  --card-white: #FFFFFF;
  --card-border-subtle: rgba(16, 26, 22, 0.08);
  --card-border-dark: rgba(255, 255, 255, 0.14);
  --shadow-card-sm: 0 4px 12px rgba(6, 36, 24, 0.07), 0 1px 2px rgba(6, 36, 24, 0.05);
  --shadow-card-lg: 0 24px 48px rgba(6, 36, 24, 0.14), 0 8px 18px rgba(6, 36, 24, 0.08);
  --shadow-card-dark: 0 24px 54px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.16);

  /* 5. Optical Bilingual Typography */
  --font-en-display: 'Space Grotesk', 'Plus Jakarta Sans', system-ui, sans-serif;
  --font-en-body: 'Plus Jakarta Sans', system-ui, sans-serif;
  --font-bn-display: 'Hind Siliguri', 'Noto Sans Bengali', sans-serif;
  --font-bn-body: 'Noto Sans Bengali', 'Hind Siliguri', sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  --font-ar: 'Amiri', serif;

  /* 6. Spacing Scale (8px Grid) & Broadcast Safe Zones */
  --space-1: 8px;
  --space-2: 16px;
  --space-3: 24px;
  --space-4: 32px;
  --space-5: 48px;

  --safe-top-9x16: 124px;
  --safe-bottom-9x16: 310px;
  --safe-left-9x16: 64px;
  --safe-right-9x16: 64px;

  --safe-top-16x9: 64px;
  --safe-bottom-16x9: 96px;
  --safe-x-16x9: 96px;

  /* 7. Radii */
  --radius-pill: 999px;
  --radius-card: 28px;
  --radius-md: 18px;
  --radius-tile: 14px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
